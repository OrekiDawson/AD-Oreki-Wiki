{
  "name": "ordered-explorer",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "quartz": {
    "name": "ordered-explorer",
    "displayName": "Ordered Explorer",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "folderDefaultState": "collapsed",
      "folderClickBehavior": "link",
      "useSavedState": true
    },
    "components": {
      "OrderedExplorer": {
        "displayName": "Ordered Explorer",
        "defaultPosition": "left",
        "defaultPriority": 50
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components.js"
    },
    "./package.json": "./package.json"
  }
}
